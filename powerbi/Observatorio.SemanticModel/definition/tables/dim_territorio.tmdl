table dim_territorio
	lineageTag: a190defd-8058-44f9-a243-984735057a00

	column territorio_codigo
		dataType: int64
		formatString: 0
		lineageTag: 3a46e89b-3820-4341-b586-77b846e4852c
		summarizeBy: none
		sourceColumn: territorio_codigo

	column territorio_nome
		dataType: string
		lineageTag: c8db2fa9-2317-4971-822a-0227eff6c6a3
		summarizeBy: none
		sourceColumn: territorio_nome

	column data_carga
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: c0f1040a-6a90-4648-94e5-f42e5e28ffee
		summarizeBy: none
		sourceColumn: data_carga

	partition dim_territorio = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor & ":" & Porta, Banco),
				    Tabela = Fonte{[Schema="warehouse",Item="dim_territorio"]}[Data],
				    Filtrada = Table.SelectRows(Tabela, each [nivel] = "N3"),
				    Colunas = Table.SelectColumns(Filtrada, {"territorio_codigo", "territorio_nome", "data_carga"})
				in
				    Colunas

