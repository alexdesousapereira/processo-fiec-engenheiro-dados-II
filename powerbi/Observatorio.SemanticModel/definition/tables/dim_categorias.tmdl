table dim_categorias
	lineageTag: 6490d6fa-cc95-4767-ad96-d7c648b8fa06

	column categoria_codigo
		dataType: int64
		formatString: 0
		lineageTag: cc6ec7cb-8693-49a1-ba90-e627123f714c
		summarizeBy: none
		sourceColumn: categoria_codigo

	column categoria_cnae
		dataType: string
		lineageTag: 8edc2294-d289-4870-b9c4-2f784b881f9a
		summarizeBy: none
		sourceColumn: categoria_cnae

	column categoria_nome
		dataType: string
		lineageTag: ace2418f-7d98-48be-9895-de7bc4e4d6e5
