table dim_categorias
	lineageTag: 422a5b01-468c-4d78-a99e-87fe07a41910

	column categoria_codigo
		dataType: int64
		formatString: 0
		lineageTag: 324b257b-1999-4573-94a5-690cf5f954cf
		summarizeBy: none
		sourceColumn: categoria_codigo

	column categoria_cnae
		dataType: string
		lineageTag: 62221265-da8e-4688-b543-2907ce4e3fbe
		summarizeBy: none
		sourceColumn: categoria_cnae

	column categoria_nome
		dataType: string
		lineageTag: 4158506a-8b1e-4672-b334-e8da160f041d
