		sourceColumn: categoria_nome

	column categoria_rotulo
		dataType: string
		lineageTag: 27c6e488-e7fc-4e97-9164-b5c8b398ba56
		summarizeBy: none
		sourceColumn: categoria_rotulo

	partition dim_categorias = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor & ":" & Porta, Banco),
				    Tabela = Fonte{[Schema="warehouse",Item="dim_categorias"]}[Data],
				    Filtrada = Table.SelectRows(Tabela, each [eh_atividade_transformacao] = true),
				    Colunas = Table.SelectColumns(Filtrada, {"categoria_codigo", "categoria_cnae", "categoria_nome"}),
				    Calculada1 = Table.AddColumn(Colunas, "categoria_rotulo", each [categoria_cnae] & " " & [categoria_nome], type text)
				in
				    Calculada1

