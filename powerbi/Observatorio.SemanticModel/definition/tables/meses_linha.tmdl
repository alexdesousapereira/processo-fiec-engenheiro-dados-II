table meses_linha
	lineageTag: 39db7864-6493-4dac-a014-7a72ffe9c16f

	column periodo
		dataType: int64
		formatString: 0
		lineageTag: 0d3b2602-486a-407d-b673-4685d968f482
		summarizeBy: none
		sourceColumn: periodo

	column mes
		dataType: int64
		formatString: 0
		lineageTag: 6ad7f335-354c-41b8-bc23-c5b45c45aefc
		summarizeBy: none
		sourceColumn: mes

	column mes_nome
		dataType: string
		lineageTag: c2afd34e-b314-47db-a696-840a5277e262
		summarizeBy: none
		sourceColumn: mes_nome

	column mes_curto
		dataType: string
		lineageTag: 7aee3a3a-0ed9-4939-9703-f887f7195e0d
		summarizeBy: none
		sourceColumn: mes_curto
		sortByColumn: mes

	partition meses_linha = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor & ":" & Porta, Banco),
				    Tabela = Fonte{[Schema="warehouse",Item="dim_calendario"]}[Data],
				    Filtrada = Table.SelectRows(Tabela, each [ano] = 2025),
				    Colunas = Table.SelectColumns(Filtrada, {"periodo", "mes", "mes_nome"}),
				    Calculada1 = Table.AddColumn(Colunas, "mes_curto", each Text.Start([mes_nome], 3), type text)
				in
				    Calculada1

