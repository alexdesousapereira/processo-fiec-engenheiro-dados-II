table vw_transformacao_2025
	lineageTag: 1693e37c-4dfb-45a5-8c68-e97f18bff845

	measure 'Índice de produção' = AVERAGE(vw_transformacao_2025[indice_producao])
		formatString: #,0.00
		lineageTag: ebb1b17e-a92d-4f1e-9614-5b243f844598

	measure 'Média das atividades' = AVERAGE(vw_transformacao_2025[media_atividades_uf_mes])
		formatString: #,0.00
		lineageTag: dd763219-9ebc-4b23-87ac-0e052d7da3b8

	measure 'Diferença para a média' = [Índice de produção] - [Média das atividades]
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: e76773fe-5249-421a-abde-fe3c11b8d764

	measure 'Atividades acima da média' = COUNTROWS(FILTER(vw_transformacao_2025, vw_transformacao_2025[diferenca_para_media] > 0)) + 0
		formatString: 0
		lineageTag: c2ba307e-ea1f-46ec-8865-1aa89ff050bd

	measure 'Cor da diferença' = IF([Diferença para a média] >= 0, "#0CA30C", "#D03B3B")
		lineageTag: ccdfbde0-968e-42bb-b2a8-6da9a890046b

