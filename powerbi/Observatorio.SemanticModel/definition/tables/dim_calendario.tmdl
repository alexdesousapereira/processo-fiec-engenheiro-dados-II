table dim_calendario
	lineageTag: 6e712ce8-0706-4d9a-a611-b7c1f38556db

	column periodo
		dataType: int64
		formatString: 0
		lineageTag: 632630d0-045c-4317-834b-d45246f9d7ed
		summarizeBy: none
		sourceColumn: periodo

	column ano
		dataType: int64
		formatString: 0
		lineageTag: c32e8861-8f3c-4357-ba4b-5425b2c3c68b
		summarizeBy: none
		sourceColumn: ano

	column mes
		dataType: int64
		formatString: 0
		lineageTag: 3d853ab1-905c-40d4-81d5-09bddcb91ae5
		summarizeBy: none
		sourceColumn: mes

	column mes_nome
		dataType: string
		lineageTag: 434c153a-5084-4b77-98ba-22faa3e842bc
		summarizeBy: none
		sourceColumn: mes_nome
		sortByColumn: mes

	partition dim_calendario = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor & ":" & Porta, Banco),
				    Tabela = Fonte{[Schema="warehouse",Item="dim_calendario"]}[Data],
				    Filtrada = Table.SelectRows(Tabela, each [ano] = 2025),
				    Colunas = Table.SelectColumns(Filtrada, {"periodo", "ano", "mes", "mes_nome"})
				in
				    Colunas

