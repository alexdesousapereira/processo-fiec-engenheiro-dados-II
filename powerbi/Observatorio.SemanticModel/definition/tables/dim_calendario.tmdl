	partition dim_calendario = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor & ":" & Porta, Banco),
				    Tabela = Fonte{[Schema="warehouse",Item="dim_calendario"]}[Data],
				    Filtrada = Table.SelectRows(Tabela, each [ano] = 2025),
				    Colunas = Table.SelectColumns(Filtrada, {"periodo", "ano", "mes", "mes_nome", "mes_curto"})
				in
				    Colunas

