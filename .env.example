# Copie para .env. Os valores servem apenas para o ambiente local.

# Banco do pipeline e do Airflow
POSTGRES_USER=pim
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pim
POSTGRES_PORTA=5432

# API de ingestão
INGESTAO_PORTA=8000

# Usuário somente leitura para o Power BI
PIM_LEITURA_SENHA=troque-esta-senha-de-leitura

# Airflow. Gere valores próprios se o ambiente sair da máquina local.
AIRFLOW_PORTA=8080
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=troque-esta-chave-com-pelo-menos-32-caracteres
AIRFLOW_JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
